{
  "name": "wirebuddy",
  "version": "0.14.0",
  "description": "A lightweight Wireshark-style packet viewer for the browser, with live capture and MCP tools so an AI agent can look at the same capture as you",
  "keywords": [
    "wireshark",
    "sharkd",
    "dumpcap",
    "pcap",
    "pcapng",
    "packet-analysis",
    "network",
    "mcp",
    "model-context-protocol",
    "claude"
  ],
  "homepage": "https://github.com/dngames/wirebuddy#readme",
  "bugs": {
    "url": "https://github.com/dngames/wirebuddy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dngames/wirebuddy.git"
  },
  "license": "MIT",
  "author": "Michael Haar",
  "type": "module",
  "bin": {
    "wirebuddy": "dist/server/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "examples",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "start": "node dist/server/main.js",
    "mcp": "node dist/server/main.js --mcp",
    "test": "node test/units.mjs && node test/framestore.mjs && node test/slices.mjs && node test/api-smoke.mjs && node test/mcp-smoke.mjs && node test/panels-smoke.mjs",
    "test:live": "node test/live-smoke.mjs && node test/live-tail.mjs && node test/live-follow.mjs",
    "test:browser": "node test/browser.mjs && node test/browser-control.mjs",
    "test:examples": "node test/investigation.mjs",
    "test:package": "node test/package.mjs",
    "demo": "node test/agent-demo.mjs",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "pretest:browser": "npm run build",
    "pretest:package": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
